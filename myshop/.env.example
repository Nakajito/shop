
# Django
SECRET_KEY=your-secret-key-here
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_API_VERSION=2023-10-16
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Redis (desarrollo: Docker redis://localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Celery (desarrollo: RabbitMQ via Docker como broker, Redis para resultados)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# PRODUCTION (VPS con CloudPanel — ajustar valores reales)
# =============================================================================

# Django
# SECRET_KEY=genera-una-clave-segura-con-python-c-"from-django.core.management.utils-import-get_random_secret_key;print(get_random_secret_key())"
# DJANGO_ENV=production
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# PostgreSQL
# DB_NAME=myshop_db
# DB_USER=myshop_user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# Redis (producción: redis-server del sistema)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=1
# REDIS_CACHE_URL=redis://localhost:6379/2

# Celery (producción: RabbitMQ como broker, Redis para resultados)
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Stripe
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_API_VERSION=2023-10-16
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx  # Obtener con: journalctl -u stripe-webhook -n 30

# Sentry (opcional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# API Deepl
DEEPL_API_KEY=your-deepl-api-key-here