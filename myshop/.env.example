
# Django
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
# ADMIN_URL=admin/  # optional: change to obscure the admin path in production
# MFA_ENFORCE_STAFF=False  # only set True after every staff account enrolled — see SECURITY.md

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_API_VERSION=2023-10-16
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Redis (desarrollo: Docker redis://localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Celery (desarrollo: RabbitMQ via Docker como broker, Redis para resultados)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# PRODUCTION / STAGING (Coolify)
# =============================================================================

# Django
# DJANGO_SETTINGS_MODULE=myshop.settings.production
# SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key;print(get_random_secret_key())">
# ALLOWED_HOSTS=synkfood.onesynk.com.mx,localhost
# CSRF_TRUSTED_ORIGINS=https://synkfood.onesynk.com.mx

# PostgreSQL (Coolify managed)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Redis (Coolify managed — one instance for cache + sessions + Celery)
# REDIS_CACHE_URL=redis://:password@host:6379/2

# Stripe (live for production, test-mode for staging)
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxx
# STRIPE_API_VERSION=2023-10-16
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Resend (transactional email)
# RESEND_API_KEY=re_xxxxx
# DEFAULT_FROM_EMAIL=no-reply@onesynk.com.mx

# Sentry (opcional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# API Deepl
DEEPL_API_KEY=your-deepl-api-key-here
