# Copy to .env and fill in real values. `make install` does this automatically
# if .env doesn't exist yet. Settings selection: DJANGO_SETTINGS_MODULE
# (unset -> development; myshop.settings.production -> production; tests use
# myshop.settings.testing directly and don't read this file).

SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Stripe (required — base.py raises at import if unset) ---
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_API_VERSION=2024-04-10
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (required: DEFAULT_FROM_EMAIL; host user/password optional) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# --- Google OAuth login (optional — leave blank to disable the "Continuar
# con Google" button). Create credentials at
# https://console.cloud.google.com/apis/credentials and add BOTH of these as
# Authorized redirect URIs (i18n_patterns prefixes even the default
# language, so /es/ and /en/ are two different callback URLs):
#   https://YOUR_DOMAIN/es/accounts/google/login/callback/
#   https://YOUR_DOMAIN/en/accounts/google/login/callback/
# and for local dev:
#   http://127.0.0.1:8000/es/accounts/google/login/callback/
#   http://127.0.0.1:8000/en/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional integrations (degrade gracefully when unset) ---
DEEPL_API_KEY=

# --- Redis / Celery (defaults work for local dev with Redis on localhost) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# --- Production-only (myshop.settings.production) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# REDIS_CACHE_URL=redis://redis:6379/2
# SENTRY_DSN=
# RESEND_API_KEY=
